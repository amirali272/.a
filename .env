# =============================================================================
# فایل تنظیمات بات — این فایل را کپی کن و اسمش را بگذار .env (بدون .example)
#   cp .env.example .env
# سپس مقادیر را پر کن. فایل .env هرگز نباید جایی مثل گیت‌هاب آپلود شود چون
# توکن بات داخلش است — هر کسی توکن را ببیند می‌تواند جای تو کنترل بات را بگیرد.
#
# فقط BOT_TOKEN اجباری است؛ همه‌ی بقیه اختیاری‌اند و اگر خالی بمانند، بات از
# مقدار پیش‌فرضی که جلویشان نوشته شده استفاده می‌کند.
# =============================================================================


# --- ضروری --------------------------------------------------------------
# توکن بات را از @BotFather بگیر (دستور /newbot یا /token)
BOT_TOKEN=

# آیدی عددی مالک(های) اصلی بات، با کاما جدا کن. این افراد در همه‌ی گروه‌ها
# دسترسی کامل ادمین دارند، حتی اگر در آن گروه خاص ادمین نباشند.
# آیدی عددی‌ات را با زدن /myid به بات (بعد از راه‌اندازی) پیدا کن.
# مثال: OWNER_IDS=123456789,987654321
OWNER_IDS=


# --- شبکه (اختیاری) -------------------------------------------------------
# اگر تلگرام در سرورت فیلتر است، یک پروکسی socks5/http بگذار:
# PROXY_URL=socks5://user:pass@host:port
PROXY_URL=

# مسیر فایل دیتابیس. پیش‌فرض: کنار خودِ bot.py با نام lottery.db
DB_PATH=lottery.db


# --- ایموجی پرمیوم (اختیاری) ----------------------------------------------
# 1 = ایموجی‌های سفارشی خاموش و فقط ایموجی معمولی استفاده می‌شود (پیش‌فرض و توصیه‌شده)
# 0 = ایموجی‌های سفارشی روشن — فقط اگر خودِ بات اکانت پرمیوم دارد این را صفر کن،
#     وگرنه تلگرام پیام‌هایی که ایموجی سفارشی دارند را رد می‌کند.
DISABLE_CUSTOM_EMOJI=0


# --- منطقه‌ی زمانی و رفتار عمومی ------------------------------------------
# برای محاسبه‌ی درست «حالت شب». پیش‌فرض: Asia/Tehran
BOT_TZ=Asia/Tehran

# مدت سایلنت خودکار وقتی کسی اسپم/فلاد کند (به دقیقه). پیش‌فرض: 5
FLOOD_MUTE_MINUTES=5


# --- XP و لول (اختیاری) ----------------------------------------------------
# بازه‌ی XP که هر پیام می‌دهد
XP_MIN=1
XP_MAX=3
# حداقل فاصله بین دو باری که XP گرفته می‌شود (ثانیه). 0 یعنی هر پیام XP دارد.
XP_COOLDOWN=0


# --- قیمت بازار (اختیاری) ---------------------------------------------------
# منبع دلخواه برای نرخ دلار، اگر منابع پیش‌فرض کار نکردند
# USD_SOURCE_URL=https://example.com/api/usd
# واحد پاسخ آن منبع: rial یا toman
USD_SOURCE_UNIT=rial

# آدرس API قیمت انس طلا (پیش‌فرض کار می‌کند، نیازی به تغییر نیست)
GOLD_URL=https://api.gold-api.com/price/XAU

# اگر همه‌ی منابع نرخ دلار قطع بودند، این دو را برای نرخ دستیِ موقت پر کن
# (فقط یکی از این دو کافی است)
MARKET_USD_TOMAN=
MARKET_USD_IRR=

# اگر منبع انس طلا هم قطع بود
MARKET_GOLD_USD=

# بازه‌ی منطقی قیمت دلار به تومان — برای تشخیص خودکار اشتباه ریال/تومان
USD_SANITY_MIN=30000
USD_SANITY_MAX=5000000

# مهلت هر درخواست قیمت (ثانیه) و مدت کش نتیجه (ثانیه)
PRICE_TIMEOUT=12
PRICE_CACHE_TTL=60
